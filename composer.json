{
  "name": "whallysson/money-precision",
  "description": "A simple library for precise monetary value handling and financial calculations",
  "keywords": [
    "Money",
    "money-precision",
    "money precision"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Whallysson Avelino",
      "email": "whallysson.dev@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-bcmath": "*"
  },
  "require-dev": {
    "laravel/pint": "^1.29",
    "pestphp/pest": "^4.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "rector/rector": "^2.0",
    "symfony/var-dumper": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "Whallysson\\Money\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "refacto": "rector",
    "lint": "pint",
    "test:refacto": "rector --dry-run",
    "test:lint": "pint --test",
    "test:type:check": "phpstan analyse --ansi",
    "test:unit": "pest --colors=always",
    "test:type:coverage": "XDEBUG_MODE=coverage pest --coverage --min=100",
    "test": [
      "@test:refacto",
      "@test:lint",
      "@test:type:check",
      "@test:type:coverage",
      "@test:unit"
    ]
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
